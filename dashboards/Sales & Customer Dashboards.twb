              <calculation class='tableau' formula='IF COUNTD([CY Sales (copy)_1700395292106752]) = WINDOW_MAX(COUNTD([CY Sales (copy)_1700395292106752]))&#13;&#10;THEN COUNTD([CY Sales (copy)_1700395292106752])&#13;&#10;ELSEIF COUNTD([CY Sales (copy)_1700395292106752]) = WINDOW_MIN(COUNTD([CY Sales (copy)_1700395292106752]))&#13;&#10;THEN COUNTD([CY Sales (copy)_1700395292106752])&#13;&#10;END'>
